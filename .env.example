# Copy to .env (gitignored) and fill in. direnv loads it through .envrc.
#
# Cloud API key used only by Terraform to create and destroy the lab.
# Create it with your user account:
#   confluent api-key create --resource cloud --description "confluent-streamhouse-lab terraform"
# The provider reads these two variables directly.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# Optional overrides. Defaults live in terraform/variables.tf.
# TF_VAR_cloud_region=us-east-1
# TF_VAR_kafka_cluster_type=basic
