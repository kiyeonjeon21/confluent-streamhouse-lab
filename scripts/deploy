#!/usr/bin/env bash
# Plans the Terraform changes, shows them, and applies only after you type "apply".
# Every apply that adds resources is billable. See docs/plan.md for what each step adds.
#
#   scripts/deploy            plan and apply terraform/ with terraform.tfvars if present
#   scripts/deploy --plan     plan only; never applies
set -euo pipefail
cd "$(dirname "$0")/../terraform"

plan_only=false
[[ "${1:-}" == "--plan" ]] && plan_only=true

: "${CONFLUENT_CLOUD_API_KEY:?set it in .env (see .env.example) and run direnv allow}"
: "${CONFLUENT_CLOUD_API_SECRET:?set it in .env (see .env.example) and run direnv allow}"

plan_file="lab.tfplan"
# The plan file can hold sensitive values; never leave it behind.
trap 'rm -f "$plan_file"' EXIT

terraform init -input=false >/dev/null
terraform plan -input=false -out="$plan_file"

if $plan_only; then
  echo "Plan only. Nothing was applied."
  exit 0
fi

echo
read -r -p "Type 'apply' to create or change these billable resources: " answer
if [[ "$answer" != "apply" ]]; then
  echo "Aborted. Nothing was applied."
  exit 1
fi

terraform apply -input=false "$plan_file"

# Terraform state holds API secrets in plaintext; keep it owner-only.
chmod 600 terraform.tfstate terraform.tfstate.backup 2>/dev/null || true
echo
echo "Applied. Next: uv run lab status"
